---
import DemoLayout from "../layouts/DemoLayout.astro";
import styles from "./scratching.module.css";
---

<DemoLayout
  title="Scratching"
  description="Load a sample, inspect its reversed buffer, and audition each direction."
>
  <a class="back-link" href="/">← All demos</a>
  <section class="demo-intro" aria-labelledby="page-title">
    <h1 id="page-title">Scratching</h1>
    <p>
      Start with Hyperblam’s Tay Zonday vocal sample or replace it with any
      browser-decodable local audio file. The demo stores a forward buffer and
      a separately reversed buffer for later scratch playback.
    </p>
  </section>

  <section class={styles.demo} data-scratch aria-label="Scratch sample loader">
    <div class={styles.loadingControls}>
      <div class={styles.actions}>
        <button class={styles.primaryButton} type="button" data-load-default>
          Load default track
        </button>
        <label class={`${styles.secondaryButton} ${styles.fileButton}`}>
          Choose file
          <input class={styles.fileInput} data-file type="file" accept="audio/*" />
        </label>
      </div>
      <div class={styles.sourceState}>
        <output class={styles.status} data-status data-state="idle">
          no track loaded
        </output>
        <output class={styles.sourceName} data-source-name>—</output>
      </div>
    </div>

    <p class={styles.error} data-error hidden></p>

    <section class={styles.transport} aria-labelledby="transport-title">
      <h2 id="transport-title">Automatic scratch</h2>
      <div class={styles.actions}>
        <button class={styles.primaryButton} type="button" data-auto disabled>
          Start automatic scratch
        </button>
        <button class={styles.secondaryButton} type="button" data-stop disabled>
          Stop
        </button>
      </div>
    </section>

    <section class={styles.buffer} aria-labelledby="buffer-title">
      <div>
        <h2 id="buffer-title">Source and slice</h2>
      </div>
      <dl class={styles.metadata} data-metadata hidden></dl>
      <section class={styles.waveform} data-waveform hidden aria-labelledby="waveform-title">
        <div class={styles.waveformHeading}>
          <div>
            <h3 id="waveform-title">Forward and reversed buffers</h3>
            <p>Both rows contain the same audio region. The lower row is a precomputed reversed buffer, not negative-rate playback.</p>
          </div>
          <output data-waveform-hit aria-live="polite">No hit scheduled</output>
        </div>
        <canvas data-waveform-canvas aria-label="Forward and reversed audio buffer waveforms"></canvas>
        <ul class={styles.waveformLegend} aria-label="Waveform legend">
          <li data-kind="selection">Selected original region</li>
          <li data-kind="hit">Most recent hit</li>
          <li data-kind="playhead">Playback position</li>
        </ul>
        <p class={styles.auditionHint}>
          Auditions play the selected maximum-duration slice at its original
          speed. Detune, LFO, choking, jitter, and automatic-scratch settings
          apply only to automatic playback.
        </p>
        <div class={styles.actions}>
          <button class={styles.primaryButton} type="button" data-forward disabled>
            Play forward clip
          </button>
          <button class={styles.secondaryButton} type="button" data-reverse disabled>
            Play matching reversed clip
          </button>
        </div>
      </section>
      <fieldset class={styles.sliceControls}>
        <legend>Clip region in the original recording</legend>
        <label>
          <span>Start <output data-slice-start-value>0.000 s</output></span>
          <input data-slice-start type="range" min="0" max="1" step="0.001" value="0" disabled />
        </label>
        <label>
          <span>Duration Min <output data-duration-min-value>0.063 s</output></span>
          <input data-duration-min type="range" min="0.01" max="1" step="0.001" value="0.063" disabled />
        </label>
        <label>
          <span>Duration Max <output data-duration-max-value>0.150 s</output></span>
          <input data-duration-max type="range" min="0.01" max="1" step="0.001" value="0.15" disabled />
        </label>
      </fieldset>
      <fieldset class={styles.directionControls}>
        <legend>Direction</legend>
        <p class={styles.controlHint}>Choose how automatic hits select between the forward and reversed buffers.</p>
        <label class={styles.directionSelect}>Automatic direction <select data-direction-mode><option value="alternate">Alternate</option><option value="random">Random</option></select></label>
      </fieldset>
      <fieldset class={styles.autoControls}>
        <legend>Retriggering</legend>
        <p class={styles.controlHint}>Schedule short hits ahead on the audio clock, with optional gaps and a full-sample release during rests.</p>
        <div class={styles.numberControls}>
          <label>Tempo (BPM) <input data-bpm type="number" min="40" max="240" value="94" /></label>
          <label>Scratch bars <input data-scratch-bars type="number" min="1" max="64" value="1" /></label>
          <label>Scratch steps <input data-scratch-steps type="number" min="1" max="64" value="16" /></label>
          <label>Rest bars <input data-rest-bars type="number" min="1" max="64" value="1" /></label>
          <label>Rest steps <input data-rest-steps type="number" min="1" max="64" value="1" /></label>
          <label>Random seed <input data-seed type="text" value="chocolate" /></label>
        </div>
        <p class={styles.seedHint}>The seed is read when automatic playback starts. Same seed and settings, same random hit/direction/duration/jitter sequence.</p>
        <label class={styles.rangeControl}>
          <span>Hit probability <output data-probability-value>60%</output></span>
          <input data-probability type="range" min="0" max="1" step="0.01" value="0.6" />
        </label>
        <label class={styles.checkControl}><input data-release-enabled type="checkbox" checked /> At the start of each rest phrase, play the full forward sample with a turntable-style speed-up</label>
        <label class={styles.rangeControl}>
          <span>Timing jitter <output data-jitter-value>0 ms</output></span>
          <input data-jitter type="range" min="0" max="60" step="1" value="0" />
        </label>
      </fieldset>
      <fieldset class={styles.gateControls}>
        <legend>Gate</legend>
        <p class={styles.controlHint}>Every voice uses a fixed 5 ms attack/release envelope; choking fades the previous automatic voice before the next begins.</p>
        <label class={styles.rangeControl}>
          <span>Choke time <output data-choke-value>5 ms</output></span>
          <input data-choke type="range" min="1" max="100" step="1" value="5" />
        </label>
      </fieldset>
      <fieldset class={styles.speedControls}>
        <legend>Speed and pitch</legend>
        <p class={styles.nodeGraph}><code>OscillatorNode → GainNode → AudioBufferSourceNode.detune</code>. The modulation signal is never connected to the speakers.</p>
        <label class={styles.rangeControl}>
          <span>Base detune <output data-detune-value>0 cents</output></span>
          <input data-detune type="range" min="-1200" max="1200" step="1" value="0" />
        </label>
        <label class={styles.checkControl}><input data-lfo-enabled type="checkbox" checked /> Modulate source <code>detune</code> with an LFO</label>
        <div class={styles.numberControls}>
          <label>LFO waveform <select data-lfo-wave><option value="sine">Sine</option><option value="triangle">Triangle</option><option value="sawtooth">Sawtooth</option><option value="square">Square</option></select></label>
          <label class={styles.rangeControl}>LFO rate <output data-lfo-rate-value>3 Hz</output><input data-lfo-rate type="range" min="0.1" max="20" step="0.1" value="3" /></label>
          <label class={styles.rangeControl}>LFO depth <output data-lfo-depth-value>700 cents</output><input data-lfo-depth type="range" min="0" max="1200" step="1" value="700" /></label>
        </div>
      </fieldset>
      <section class={styles.eventLog} aria-labelledby="event-log-title">
        <div>
          <h3 id="event-log-title">Audio event log</h3>
          <p>Every button press creates a new one-shot AudioBufferSourceNode.</p>
        </div>
        <ol data-event-log></ol>
      </section>
    </section>
  </section>
</DemoLayout>

<script>
  import { setupScratch } from "../components/scratch";

  const root = document.querySelector<HTMLElement>("[data-scratch]");
  if (root) setupScratch(root);
</script>
